# Managed by Ansible. Edit inventory variables rather than this file.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - {{ prometheus_self_target | to_json }}
        labels:
          app: prometheus
{% if prometheus_traefik_target %}

  - job_name: traefik
    static_configs:
      - targets:
          - {{ prometheus_traefik_target | to_json }}
        labels:
          app: traefik
{% endif %}
{% if prometheus_proxmox_target and prometheus_pve_exporter_target %}

  - job_name: proxmox
    metrics_path: /pve
    params:
      module:
        - {{ prometheus_pve_module | to_json }}
    static_configs:
      - targets:
          - {{ prometheus_proxmox_target | to_json }}
        labels:
          app: proxmox
    relabel_configs:
      - source_labels:
          - __address__
        target_label: __param_target
      - source_labels:
          - __param_target
        target_label: instance
      - target_label: __address__
        replacement: {{ prometheus_pve_exporter_target | to_json }}
{% endif %}
